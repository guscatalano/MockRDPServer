<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The console/scriptable server. The GUI tray (MockRdp.Tray) is the run-this one. -->
    <AssemblyName>MockRdpCli</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MockRdp.Plugin\MockRdp.Plugin.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
    <!-- Software rendering of the fake desktop (managed, no native deps). -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.*" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.*" />
    <PackageReference Include="SixLabors.Fonts" Version="2.1.*" />
  </ItemGroup>

</Project>
